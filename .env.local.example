# Supabase project (server-side only — service role key MUST stay server-only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ... (public anon key)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (server-only — never expose)

# Single admin password (gate to /admin/*)
ADMIN_PASSWORD=change-me-to-a-strong-passphrase

# JWT signing secret (>= 32 random bytes; e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-32+-random-bytes
